---
import { Image } from 'astro:assets';
import logo from '../assets/Brand/Snackybara_Logo_Mascot_Wordmark_Tagline_FullColor_Tranparent_Background_01.png';
const navLinks = [
  { label: 'Home',    href: '/' },
  { label: 'Menu',    href: '/menu' },
  { label: 'About',   href: '/about' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Contact', href: '/contact' },
];

const year = new Date().getFullYear();
---

<footer class="bg-stone-900 text-stone-300">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16 pb-12 border-b border-stone-700">

      <!-- Brand column -->
      <div class="md:col-span-1">
        <a href="/" class="inline-block group mb-4" aria-label="Snackybara FoodHub — Home">
          <Image
            src={logo}
            alt="Snackybara FoodHub"
            height={80}
            class="h-16 w-auto object-contain opacity-90 group-hover:opacity-100 transition-opacity duration-200"
          />
        </a>
        <p class="text-sm text-stone-400 leading-relaxed max-w-xs">
          Crafted snacks and warm bites made with care — a little taste of home in every bite.
        </p>
        <!-- Social icons -->
        <div class="flex gap-3 mt-6">
          <!-- Facebook -->
          <a
            href="https://www.facebook.com/snackybara"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Snackybara on Facebook"
            class="w-10 h-10 rounded-full border border-stone-600 flex items-center justify-center text-stone-400 hover:text-white hover:border-terra-400 hover:bg-terra-500 transition-all duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/snacky.bara/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Snackybara on Instagram"
            class="w-10 h-10 rounded-full border border-stone-600 flex items-center justify-center text-stone-400 hover:text-white hover:border-terra-400 hover:bg-terra-500 transition-all duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-stone-400 mb-5">
          Quick Links
        </h3>
        <ul class="space-y-3 list-none m-0 p-0">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-stone-300 hover:text-terra-300 transition-colors duration-200"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact / store info -->
      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-stone-400 mb-5">
          Visit Us
        </h3>
        <ul class="space-y-3 list-none m-0 p-0 text-sm text-stone-300">
          <li class="leading-snug text-stone-300">
            56 Katipunan St, Marikina,<br />1811 Metro Manila
          </li>
          <li class="text-xs text-stone-400">
            <strong>Mon – Sat:</strong> 10:00 AM – 10:00 PM<br />
            <span class="text-stone-500">Sunday: Closed</span>
          </li>
          <li class="pt-2">
            <a href="/contact" class="text-terra-400 hover:text-terra-300 transition-colors duration-200 font-medium">
              View Map &amp; Contact →
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-stone-500">
      <p>© {year} Snackybara FoodHub. All rights reserved.</p>
      <p class="text-stone-600">Made with ♥ in the Philippines</p>
    </div>
  </div>
</footer>
