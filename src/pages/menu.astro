---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const allItems = await getCollection('menuItems');
const categories = [
  'All',
  'Snacky Bites',
  'Rice Meals',
  'Pasta',
  'Cozy Coffee',
  'Frappes',
  'Milkteas',
  'Bara Bundles',
  'Desserts',
];
---

<Layout
  title="Menu"
  description="Browse the Snackybara FoodHub menu — Snacky Bites, Rice Meals, Pasta, Coffee, Frappes, Milkteas, Bara Bundles, and more. Crafted with care in the Philippines."
>
  <Navbar />

  <!-- Page hero -->
  <section class="pt-28 pb-12 sm:pt-36 sm:pb-16 bg-cream-50">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-terra-500 font-body text-xs uppercase tracking-[0.2em] font-semibold mb-3">What We Serve</p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-stone-900 mb-4">Our Menu</h1>
      <p class="text-stone-500 max-w-xl mx-auto leading-relaxed">
        Made fresh with quality ingredients and a whole lot of heart.
      </p>
    </div>
  </section>

  <!-- Category filter tabs -->
  <div class="sticky top-16 sm:top-20 z-30 bg-cream-50/95 backdrop-blur-sm border-b border-stone-200 py-4">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">
      <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-hide" role="tablist" aria-label="Menu categories" id="category-tabs">
        {categories.map((cat) => (
          <button
            role="tab"
            aria-selected={cat === 'All' ? 'true' : 'false'}
            data-category={cat}
            class:list={[
              'filter-tab shrink-0 px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 border',
              cat === 'All'
                ? 'bg-terra-500 text-white border-terra-500 shadow-sm'
                : 'bg-white text-stone-600 border-stone-200 hover:border-terra-300 hover:text-terra-600',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Menu grid -->
  <section class="py-12 sm:py-16 bg-cream-50">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">
      <div id="menu-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 sm:gap-6">
        {allItems.map((item) => (
          <article
            data-category={item.data.category}
            class="menu-card group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <!-- Real food image -->
            <div class="aspect-[4/3] w-full overflow-hidden bg-stone-100 relative">
              <Image
                src={item.data.image}
                alt={item.data.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width={480}
                height={360}
              />
              {item.data.badge && (
                <span class="absolute top-3 left-3 px-3 py-1 bg-terra-500 text-white text-xs font-semibold rounded-full shadow-sm">
                  {item.data.badge}
                </span>
              )}
            </div>

            <div class="p-5">
              <div class="flex items-start justify-between gap-2 mb-2">
                <h2 class="font-display text-lg font-semibold text-stone-900 group-hover:text-terra-600 transition-colors leading-tight">
                  {item.data.name}
                </h2>
                <span class="shrink-0 text-xs font-medium text-stone-400 bg-stone-100 px-2.5 py-1 rounded-full mt-0.5 whitespace-nowrap">
                  {item.data.category}
                </span>
              </div>
              <p class="text-stone-500 text-sm leading-relaxed">{item.data.description}</p>
              {!item.data.available && (
                <p class="mt-3 text-xs font-medium text-stone-400 italic">Currently unavailable</p>
              )}
            </div>
          </article>
        ))}
      </div>

      <!-- Empty state (shown when filter has no results) -->
      <div id="empty-state" class="hidden text-center py-20 text-stone-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4 opacity-50" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
        <p class="font-display text-xl">No items in this category yet</p>
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar { display: none; }

  .menu-card {
    animation: card-in 0.4s ease forwards;
  }

  @keyframes card-in {
    from { opacity: 0; transform: scale(0.97) translateY(10px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  .menu-card.hidden-card {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-card { animation: none; }
  }
</style>

<script>
  function initMenuFilter() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const cards = document.querySelectorAll<HTMLElement>('.menu-card');
    const emptyState = document.getElementById('empty-state');
    if (!tabs.length || !cards.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const selectedCategory = tab.dataset.category ?? 'All';

        tabs.forEach((t) => {
          const isActive = t === tab;
          t.setAttribute('aria-selected', String(isActive));
          t.classList.toggle('bg-terra-500', isActive);
          t.classList.toggle('text-white', isActive);
          t.classList.toggle('border-terra-500', isActive);
          t.classList.toggle('shadow-sm', isActive);
          t.classList.toggle('bg-white', !isActive);
          t.classList.toggle('text-stone-600', !isActive);
          t.classList.toggle('border-stone-200', !isActive);
        });

        let visibleCount = 0;
        cards.forEach((card) => {
          const matches = selectedCategory === 'All' || card.dataset.category === selectedCategory;
          if (matches) {
            card.classList.remove('hidden-card');
            card.style.animation = 'none';
            card.offsetHeight;
            card.style.animation = '';
            visibleCount++;
          } else {
            card.classList.add('hidden-card');
          }
        });

        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }
      });
    });
  }

  initMenuFilter();
  document.addEventListener('astro:page-load', initMenuFilter);
</script>
