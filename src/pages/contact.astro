---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

// Replace with your real Formspree endpoint ID
// Get one free at https://formspree.io
const FORMSPREE_ID = 'YOUR_FORMSPREE_ID';
---

<Layout
  title="Contact"
  description="Get in touch with Snackybara FoodHub — send us a message, find us on social media, or swing by to say hello."
>
  <Navbar />

  <!-- Page hero -->
  <section class="pt-28 pb-12 sm:pt-36 sm:pb-16 bg-cream-50">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-terra-500 font-body text-xs uppercase tracking-[0.2em] font-semibold mb-3">We'd Love to Hear From You</p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-stone-900 mb-4">Get In Touch</h1>
      <p class="text-stone-500 max-w-xl mx-auto leading-relaxed">
        Have a question, feedback, or just want to say hello? Drop us a message below.
      </p>
    </div>
  </section>

  <!-- Contact content -->
  <section class="py-12 sm:py-16 pb-20 sm:pb-28 bg-cream-50">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">

        <!-- ── Contact form (left / wider) ── -->
        <div class="lg:col-span-3 reveal">
          <h2 class="font-display text-2xl sm:text-3xl text-stone-900 mb-8">Send Us a Message</h2>

          <!-- Success message (hidden by default) -->
          <div id="form-success" class="hidden mb-6 p-5 bg-green-50 border border-green-200 rounded-xl flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <p class="font-semibold text-green-800">Message sent successfully!</p>
              <p class="text-green-700 text-sm mt-1">Thank you for reaching out. We'll get back to you as soon as we can.</p>
            </div>
          </div>

          <!-- Error message (hidden by default) -->
          <div id="form-error" class="hidden mb-6 p-5 bg-red-50 border border-red-200 rounded-xl flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div>
              <p class="font-semibold text-red-800">Something went wrong</p>
              <p class="text-red-700 text-sm mt-1">Please try again or reach out to us directly on Facebook or Instagram.</p>
            </div>
          </div>

          <form
            id="contact-form"
            action={`https://formspree.io/f/${FORMSPREE_ID}`}
            method="POST"
            novalidate
            class="space-y-5"
          >
            <!-- Name -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="form-group">
                <label for="contact-name" class="block text-sm font-medium text-stone-700 mb-1.5">
                  Full Name <span class="text-terra-500">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="Your full name"
                  class="form-input w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-stone-800 placeholder-stone-400 text-sm transition-all duration-200 focus:border-terra-400 focus:ring-2 focus:ring-terra-100 outline-none"
                />
              </div>

              <!-- Email -->
              <div class="form-group">
                <label for="contact-email" class="block text-sm font-medium text-stone-700 mb-1.5">
                  Email Address <span class="text-terra-500">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="your@email.com"
                  class="form-input w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-stone-800 placeholder-stone-400 text-sm transition-all duration-200 focus:border-terra-400 focus:ring-2 focus:ring-terra-100 outline-none"
                />
              </div>
            </div>

            <!-- Subject -->
            <div class="form-group">
              <label for="contact-subject" class="block text-sm font-medium text-stone-700 mb-1.5">
                Subject
              </label>
              <input
                type="text"
                id="contact-subject"
                name="subject"
                autocomplete="off"
                placeholder="What's this about?"
                class="form-input w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-stone-800 placeholder-stone-400 text-sm transition-all duration-200 focus:border-terra-400 focus:ring-2 focus:ring-terra-100 outline-none"
              />
            </div>

            <!-- Message -->
            <div class="form-group">
              <label for="contact-message" class="block text-sm font-medium text-stone-700 mb-1.5">
                Message <span class="text-terra-500">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                required
                rows="6"
                placeholder="Tell us what's on your mind…"
                class="form-input w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-stone-800 placeholder-stone-400 text-sm transition-all duration-200 focus:border-terra-400 focus:ring-2 focus:ring-terra-100 outline-none resize-none leading-relaxed"
              ></textarea>
            </div>

            <!-- Honeypot (anti-spam) -->
            <input type="text" name="_gotcha" class="hidden" aria-hidden="true" tabindex="-1" />

            <button
              type="submit"
              id="submit-btn"
              class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-8 py-4 rounded-full bg-terra-500 text-white font-semibold text-sm hover:bg-terra-600 hover:scale-105 active:scale-95 disabled:opacity-60 disabled:scale-100 disabled:cursor-not-allowed transition-all duration-200 shadow-md shadow-terra-900/20"
            >
              <span id="submit-text">Send Message</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" id="submit-icon" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" id="submit-spinner" class="hidden animate-spin" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </button>
          </form>
        </div>

        <!-- ── Info sidebar (right) ── -->
        <div class="lg:col-span-2 reveal reveal-delay-2">
          <h2 class="font-display text-2xl sm:text-3xl text-stone-900 mb-8">Find Us</h2>

          <div class="space-y-6">
            <!-- Social links -->
            <div class="bg-white rounded-2xl p-6 shadow-sm">
              <h3 class="font-display text-lg font-semibold text-stone-900 mb-4">Follow Us</h3>
              <div class="space-y-3">
                <a
                  href="#"
                  class="flex items-center gap-4 p-3 rounded-xl hover:bg-stone-50 transition-colors duration-200 group"
                  aria-label="Snackybara on Facebook"
                >
                  <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#1877F2" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                  </div>
                  <div>
                    <p class="font-semibold text-stone-800 text-sm group-hover:text-blue-600 transition-colors">Facebook</p>
                    <p class="text-stone-400 text-xs">@Snackybara</p>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto text-stone-300 group-hover:text-stone-500 transition-colors" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>

                <a
                  href="#"
                  class="flex items-center gap-4 p-3 rounded-xl hover:bg-stone-50 transition-colors duration-200 group"
                  aria-label="Snackybara on Instagram"
                >
                  <div class="w-10 h-10 rounded-xl bg-pink-100 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E1306C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="#E1306C" stroke="none"/></svg>
                  </div>
                  <div>
                    <p class="font-semibold text-stone-800 text-sm group-hover:text-pink-600 transition-colors">Instagram</p>
                    <p class="text-stone-400 text-xs">@Snackybara</p>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto text-stone-300 group-hover:text-stone-500 transition-colors" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              </div>
            </div>

            <!-- Location placeholder -->
            <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
              <!-- Map placeholder -->
              <div class="bg-stone-100 h-44 flex flex-col items-center justify-center gap-3 text-stone-400">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <p class="text-sm font-body">Map coming soon</p>
              </div>
              <div class="p-5">
                <h3 class="font-display text-base font-semibold text-stone-900 mb-2">Location</h3>
                <p class="text-stone-400 text-sm italic">Address & opening hours coming soon.</p>
              </div>
            </div>

            <!-- WhatsApp quick link -->
            <a
              href="https://wa.me/YOUR_WHATSAPP_NUMBER"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-5 bg-green-50 border border-green-200 rounded-2xl hover:bg-green-100 transition-colors duration-200 group"
              aria-label="Message us on WhatsApp"
            >
              <div class="w-10 h-10 rounded-xl bg-green-500 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="18" height="18" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              </div>
              <div>
                <p class="font-semibold text-green-800 text-sm group-hover:text-green-900 transition-colors">Chat on WhatsApp</p>
                <p class="text-green-600 text-xs">Quick replies, fast support</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .form-input:focus {
    border-color: var(--color-terra-400);
    box-shadow: 0 0 0 3px rgba(184, 85, 64, 0.12);
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .animate-spin { animation: spin 0.8s linear infinite; }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const submitText = document.getElementById('submit-text');
    const submitIcon = document.getElementById('submit-icon');
    const submitSpinner = document.getElementById('submit-spinner');
    const successMsg = document.getElementById('form-success');
    const errorMsg   = document.getElementById('form-error');
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // UI: loading state
      if (submitBtn) submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Sending…';
      if (submitIcon) submitIcon.classList.add('hidden');
      if (submitSpinner) submitSpinner.classList.remove('hidden');
      successMsg?.classList.add('hidden');
      errorMsg?.classList.add('hidden');

      try {
        const data = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          successMsg?.classList.remove('hidden');
          successMsg?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          throw new Error('Form submission failed');
        }
      } catch {
        errorMsg?.classList.remove('hidden');
        errorMsg?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Send Message';
        if (submitIcon) submitIcon.classList.remove('hidden');
        if (submitSpinner) submitSpinner.classList.add('hidden');
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
